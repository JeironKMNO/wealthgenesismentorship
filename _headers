# Cloudflare Workers Static Assets — cabeceras de caché.
# HTML/CSS/JS quedan con el default (revalidan con ETag) para que cada deploy se vea al instante.

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/video/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
