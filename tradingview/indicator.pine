//@version=6
// =============================================================================
// Wealth Genesis — Señales SMC Oro (v1.4)
// -----------------------------------------------------------------------------
// Estrategia (ver ESTRATEGIA.md) — DOS CAPAS:
//
//   CAPA ALTA (4H / 1H / 15m) → DÓNDE y HACIA DÓNDE
//     Sesgo direccional y rango estructural. Sobre ese rango se tira el fib:
//     la zona de premium/descuento (61.8%–88.6%) es una ZONA DE INTERÉS,
//     un lugar donde el precio puede reaccionar. Nada más.
//
//   CAPA BAJA (5m / 2m / 1m) → SI SE ENTRA O NO
//     En la zona tiene que verse el modelo: manipulación, imbalance, y el
//     cambio de dirección que invalida los imbalances contrarios.
//
//   REGLA: una zona de interés NO es una entrada. Si la temporalidad menor
//   no confirma el movimiento, no hay operación.
//
//   TP: liquidez externa del rango (0% del fib) y expansión en las extensiones
//   -14.6% / -27.2% / -41.4% (hasta 4 take profits).
//   Gráfico limpio: solo entrada / SL / TPs. FVGs y sesiones son cálculos
//   internos (se pueden mostrar con toggles, apagados por defecto).
// =============================================================================
indicator("WG SMC — Señales Oro [v1.4]", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
// 1) FILTROS — sesiones NY y Asia (hora de Nueva York), límite diario
// ─────────────────────────────────────────────────────────────────────────────
grpF = "Filtros"
useSessions  = input.bool(true, "Operar solo en sesiones", group = grpF)
useNY        = input.bool(true, "Sesión Nueva York", group = grpF)
sessNY       = input.session("0830-1130", "Horario NY (hora NY)", group = grpF)
useAsia      = input.bool(true, "Sesión Asia", group = grpF)
sessAsia     = input.session("1900-0000", "Horario Asia (hora NY)", group = grpF)
tzNY         = "America/New_York"
allowLongs   = input.bool(true, "Permitir compras", group = grpF)
allowShorts  = input.bool(true, "Permitir ventas", group = grpF)
maxPerDay    = input.int(4, "Máx. señales por día", minval = 1, group = grpF)
shadeSessions = input.bool(false, "Sombrear sesiones en el gráfico", group = grpF)

grpJ = "Registro de operaciones"
showStats = input.bool(true,  "Mostrar estadísticas", group = grpJ, tooltip = "Aciertos, profit factor, R neto y drawdown de todas las señales del gráfico, con desglose por modelo.")
showLog   = input.bool(true,  "Mostrar últimas operaciones", group = grpJ, tooltip = "Historial con fecha, dirección, modelo que la produjo, cómo cerró y su resultado en R.")
statsPos  = input.string("Abajo derecha", "Posición de los paneles", options = ["Abajo derecha", "Abajo izquierda", "Arriba izquierda"], group = grpJ)

inNY      = useNY and not na(time(timeframe.period, sessNY, tzNY))
inAsia    = useAsia and not na(time(timeframe.period, sessAsia, tzNY))
inSession = not useSessions or inNY or inAsia

var int signalsToday = 0
if timeframe.change("D")
    signalsToday := 0

// ─────────────────────────────────────────────────────────────────────────────
// 2) SESGO HTF — estructura en temporalidad mayor (rotura del último swing)
// ─────────────────────────────────────────────────────────────────────────────
grpH = "Sesgo (temporalidad mayor)"
htfTF       = input.timeframe("60", "Temporalidad del sesgo", group = grpH, tooltip = "60 = 1H, 240 = 4H")
htfPivotLen = input.int(5, "Fuerza de swings HTF", minval = 2, group = grpH)
requireBias = input.bool(true, "Exigir sesgo a favor", group = grpH)

f_bias(_len) =>
    ph = ta.pivothigh(_len, _len)
    pl = ta.pivotlow(_len, _len)
    var float lastPH = na
    var float lastPL = na
    if not na(ph)
        lastPH := ph
    if not na(pl)
        lastPL := pl
    var int b = 0
    if not na(lastPH) and close > lastPH
        b := 1
    if not na(lastPL) and close < lastPL
        b := -1
    b

htfBias = request.security(syminfo.tickerid, htfTF, f_bias(htfPivotLen), lookahead = barmerge.lookahead_off)
biasOKLong  = not requireBias or htfBias == 1
biasOKShort = not requireBias or htfBias == -1

// ─────────────────────────────────────────────────────────────────────────────
// 3) ESTRUCTURA / RANGO — liquidez externa e interna (cálculo interno, sin dibujo)
// ─────────────────────────────────────────────────────────────────────────────
grpR = "Rango / liquidez"
rangeTF  = input.timeframe("15", "Temporalidad del RANGO (fib)", group = grpR, tooltip = "El tramo sobre el que se tira el fib se toma de esta temporalidad, aunque el gráfico esté en 1m/5m. 15 = 15m, 60 = 1H, 240 = 4H")
extLen   = input.int(5, "Fuerza swings EXTERNOS (rango)", minval = 2, group = grpR, tooltip = "Sube este valor para tramos más grandes, bájalo para tramos más recientes. Ajústalo hasta que el 100%/0% coincidan con el fib que dibujas a mano")
intLen   = input.int(3, "Fuerza swings INTERNOS", minval = 1, group = grpR)
useLegDir = input.bool(true, "Solo operar a favor del tramo", group = grpR, tooltip = "Tramo bajista (high→low) → solo ventas en premium. Tramo alcista (low→high) → solo compras en descuento.")
showRange = input.bool(false, "Mostrar niveles del rango (calibración)", group = grpR, tooltip = "Dibuja el 100% y el 0% del tramo detectado para compararlos con tu fib manual. Apágalo cuando ya coincidan.")
noRepaint = input.bool(true, "Sin repintado (tramo ya cerrado)", group = grpR, tooltip = "Usa el tramo de la vela CERRADA de la temporalidad mayor. Las señales quedan fijas: al recargar el gráfico salen en el mismo sitio y con el mismo SL. Desactívalo solo si quieres la reacción más inmediata a costa de que las señales se muevan.")

// EL TRAMO (impulso): los DOS últimos pivotes consecutivos de la temporalidad
// mayor — high→low o low→high. Es exactamente lo que se marca al tirar el fib
// a mano. No sirve tomar "el último high" y "el último low" por separado:
// pueden ser de momentos distintos y no forman ningún tramo real.
f_leg(_len) =>
    ph = ta.pivothigh(_len, _len)
    pl = ta.pivotlow(_len, _len)
    var float p1     = na      // pivote más reciente (extremo del tramo)
    var bool  p1High = false
    var float p0     = na      // pivote anterior (origen del tramo)
    if not na(ph)
        if p1High and not na(p1)
            if ph > p1        // el tramo alcista sigue: se extiende el extremo
                p1 := ph
        else
            p0 := p1
            p1 := ph
            p1High := true
    if not na(pl)
        if not p1High and not na(p1)
            if pl < p1        // el tramo bajista sigue: se extiende el extremo
                p1 := pl
        else
            p0 := p1
            p1 := pl
            p1High := false
    rh = na(p0) or na(p1) ? na : math.max(p0, p1)
    rl = na(p0) or na(p1) ? na : math.min(p0, p1)
    // Tramo bajista = el último pivote es un low (el precio vino de un high)
    bear = not p1High
    // Se devuelve tambien el valor de la vela anterior de la temporalidad mayor:
    // es el que se usa en modo "sin repintado" (ver abajo)
    [rh, rl, bear, rh[1], rl[1], bear[1]]

[rhNow, rlNow, bearNow, rhPrev, rlPrev, bearPrev] = request.security(syminfo.tickerid, rangeTF, f_leg(extLen), lookahead = barmerge.lookahead_off)

// SIN REPINTADO: en vivo, la vela de la temporalidad mayor aun se esta formando,
// asi que el tramo puede cambiar mientras corre. Al recargar el grafico, Pine
// recalcula con velas ya cerradas y las senales historicas salen en otro sitio
// (con otro SL). Usando el valor de la vela mayor ya CERRADA, lo que ves en vivo
// es lo mismo que veras manana: las senales quedan fijas.
rangeHigh = noRepaint ? rhPrev : rhNow
rangeLow  = noRepaint ? rlPrev : rlNow
legBear   = noRepaint ? bearPrev : bearNow
legOKLong  = not useLegDir or not legBear
legOKShort = not useLegDir or legBear

// ─────────────────────────────────────────────────────────────────────────────
// 3b) FRACTALIDAD — por qué un tramo es válido
//
//   Un tramo de 15m no vale por sí solo: vale si está ANIDADO dentro de una
//   estructura mayor que apunta al mismo sitio. Secuencia del mentor
//   (XAUUSD, 25/26-ago-2026):
//     1. DIARIO: el precio manipula el alto del día anterior (barre liquidez).
//     2. 1H: vuelve con fuerza dejando imbalance bajista e invalidando los
//        alcistas → aquel impulso era manipulación, no expansión. Rompe
//        estructura: ahora es bajista.
//     3. 1H: fib del high de la manipulación (100%) al low que creó el rango
//        bajista (0%). El imbalance de 1H confluye con el 71% de premium.
//     4. 15m: dentro de esa zona, nuevo quiebre de estructura → ESE es el
//        tramo que se usa para la venta.
//
//   Traducción a filtros: el precio debe estar en premium/descuento del tramo
//   ESTRUCTURAL (no solo del de ejecución), idealmente sobre un imbalance de
//   esa temporalidad, y con la liquidez diaria ya manipulada.
// ─────────────────────────────────────────────────────────────────────────────
//   Los modelos son MANERAS DE LEER EL MERCADO, no requisitos acumulativos.
//   La manipulación del alto del día anterior es uno que ocurre a menudo, pero
//   no es el único. Cada modelo se activa por separado y se elige si basta con
//   que uno se cumpla o si deben cumplirse todos. Añadir un modelo nuevo =
//   añadir su condición al bloque de abajo, sin tocar el resto del indicador.
grpX = "Modelos de contexto (fractalidad)"
combineMode = input.string("Basta con uno", "Cómo combinar los modelos", options = ["Basta con uno", "Exigir todos"], group = grpX, tooltip = "\"Basta con uno\": cualquier modelo activo que se cumpla da contexto válido (más señales, cada una etiquetada con su modelo). \"Exigir todos\": confluencia máxima, muchas menos señales.")
structTF    = input.timeframe("60", "Temporalidad estructural", group = grpX, tooltip = "Donde ocurre el quiebre de estructura que da contexto. 60 = 1H, 240 = 4H")
structLen   = input.int(5, "Fuerza swings estructurales", minval = 2, group = grpX)
useM1 = input.bool(true,  "M1 · Estructura anidada (premium/descuento de la TF mayor)", group = grpX, tooltip = "El precio está en la zona fib del tramo estructural y esa estructura va en la misma dirección. Es el modelo base.")
useM2 = input.bool(false, "M2 · Manipulación del alto/bajo del día anterior", group = grpX, tooltip = "Se barrió el ALTO del día anterior → contexto bajista; el BAJO → contexto alcista. Frecuente, pero solo una manera más de leer el mercado.")
useM3 = input.bool(false, "M3 · Imbalance de la TF estructural sin mitigar", group = grpX, tooltip = "El precio está dentro de un imbalance de la temporalidad estructural que aún no se ha rellenado (el naranja del ejemplo).")

// Tramo estructural (misma lógica de tramo, en la TF de contexto)
[sHighN, sLowN, sBearN, sHighP, sLowP, sBearP] = request.security(syminfo.tickerid, structTF, f_leg(structLen), lookahead = barmerge.lookahead_off)
structHigh = noRepaint ? sHighP : sHighN
structLow  = noRepaint ? sLowP  : sLowN
structBear = noRepaint ? sBearP : sBearN

// Imbalance vigente de la TF estructural (el último sin mitigar de cada bando)
f_htfFVG() =>
    var float bullTop = na
    var float bullBot = na
    var float bearTop = na
    var float bearBot = na
    if low > high[2]
        bullTop := low
        bullBot := high[2]
    if high < low[2]
        bearTop := low[2]
        bearBot := high
    if not na(bullBot) and close < bullBot      // rellenado → invalidado
        bullTop := na
        bullBot := na
    if not na(bearTop) and close > bearTop
        bearTop := na
        bearBot := na
    [bullTop, bullBot, bearTop, bearBot]

[hBullTop, hBullBot, hBearTop, hBearBot] = request.security(syminfo.tickerid, structTF, f_htfFVG(), lookahead = barmerge.lookahead_off)
inStructFVGShort = not na(hBearTop) and high >= hBearBot and close <= hBearTop
inStructFVGLong  = not na(hBullTop) and low <= hBullTop and close >= hBullBot

// Liquidez diaria: alto/bajo del día anterior y su manipulación
pdHigh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_off)
pdLow  = request.security(syminfo.tickerid, "D", low[1], lookahead = barmerge.lookahead_off)
var bool pdHighSwept = false
var bool pdLowSwept  = false
if timeframe.change("D")
    pdHighSwept := false
    pdLowSwept  := false
if not na(pdHigh) and high > pdHigh
    pdHighSwept := true
if not na(pdLow) and low < pdLow
    pdLowSwept := true

phI = ta.pivothigh(intLen, intLen)
plI = ta.pivotlow(intLen, intLen)
var float intHigh = na
var float intLow  = na
var float intHighPrev = na
var float intLowPrev  = na
if not na(phI)
    intHighPrev := intHigh
    intHigh := phI
if not na(plI)
    intLowPrev := intLow
    intLow := plI

// Highs/lows iguales (EQH/EQL): dos swings internos al mismo nivel = bolsa de
// liquidez que el precio suele manipular antes del movimiento real
eqTol  = input.float(1.5, "Tolerancia highs/lows iguales (puntos)", minval = 0.0, step = 0.1, group = grpR)
eqHigh = not na(intHigh) and not na(intHighPrev) and math.abs(intHigh - intHighPrev) <= eqTol ? math.max(intHigh, intHighPrev) : na
eqLow  = not na(intLow) and not na(intLowPrev) and math.abs(intLow - intLowPrev) <= eqTol ? math.min(intLow, intLowPrev) : na

// ─────────────────────────────────────────────────────────────────────────────
// 4) FIBONACCI — zona de retroceso (premium/descuento) sobre el rango
//    Compras: el precio debe haber retrocedido al 61.8%–88.6% de descuento.
//    Ventas: espejo en premium. (Niveles configurables: 61.8 / 70.5 / 78.6 / 88.6)
// ─────────────────────────────────────────────────────────────────────────────
grpFib = "Fibonacci"
useFib     = input.bool(true, "Exigir retroceso Fibonacci", group = grpFib)
fibShallow = input.float(0.618, "Retroceso mínimo", minval = 0.3, maxval = 0.95, step = 0.001, group = grpFib, tooltip = "0.618 = 61.8%")
fibDeep    = input.float(0.886, "Retroceso máximo", minval = 0.4, maxval = 1.0, step = 0.001, group = grpFib, tooltip = "0.886 = 88.6%. Más allá, el rango se considera invalidado")

rangeSize = rangeHigh - rangeLow
// Compras: fib tirado de low→high; zona de descuento entre 61.8% y 88.6% medidos desde el high
fibTopLong = rangeHigh - rangeSize * fibShallow
fibBotLong = rangeHigh - rangeSize * fibDeep
inFibLong  = not useFib or (not na(rangeSize) and low <= fibTopLong and close >= fibBotLong)
// Ventas: fib tirado de high→low; zona premium entre 61.8% y 88.6% medidos desde el low
fibBotShort = rangeLow + rangeSize * fibShallow
fibTopShort = rangeLow + rangeSize * fibDeep
inFibShort  = not useFib or (not na(rangeSize) and high >= fibBotShort and close <= fibTopShort)

// Fib del tramo ESTRUCTURAL (fractalidad): el precio debe estar también en
// premium/descuento de la temporalidad mayor. En el ejemplo del mentor, el 71%
// del fib de 1H (del high de la manipulación al low del rango bajista) es lo
// que convierte al tramo de 15m en una venta válida.
structSize      = structHigh - structLow
sFibTopLong     = structHigh - structSize * fibShallow
sFibBotLong     = structHigh - structSize * fibDeep
sFibBotShort    = structLow + structSize * fibShallow
sFibTopShort    = structLow + structSize * fibDeep
inStructFibLong  = not na(structSize) and low <= sFibTopLong and close >= sFibBotLong
inStructFibShort = not na(structSize) and high >= sFibBotShort and close <= sFibTopShort

// --- MODELOS DE CONTEXTO ------------------------------------------------------
// Cada modelo dice, a su manera, "el precio va hacia aquí". Se combinan según
// el modo elegido. Para añadir un modelo nuevo: define mNLong / mNShort, su
// input useMN, y súmalo a las tres líneas de abajo.
m1Long  = inStructFibLong and not structBear     // estructura anidada
m1Short = inStructFibShort and structBear
m2Long  = pdLowSwept                             // manipulación de liquidez diaria
m2Short = pdHighSwept
m3Long  = inStructFVGLong                        // imbalance de la TF estructural
m3Short = inStructFVGShort

anyModel   = useM1 or useM2 or useM3
requireAll = combineMode == "Exigir todos"

fractalLong  = not anyModel ? true : requireAll ? ((not useM1 or m1Long) and (not useM2 or m2Long) and (not useM3 or m3Long)) : ((useM1 and m1Long) or (useM2 and m2Long) or (useM3 and m3Long))
fractalShort = not anyModel ? true : requireAll ? ((not useM1 or m1Short) and (not useM2 or m2Short) and (not useM3 or m3Short)) : ((useM1 and m1Short) or (useM2 and m2Short) or (useM3 and m3Short))

// Etiqueta de qué modelo(s) respaldan la señal — va en la alerta y el panel
f_models(_isLong) =>
    t = ""
    if useM1 and (_isLong ? m1Long : m1Short)
        t += "M1"
    if useM2 and (_isLong ? m2Long : m2Short)
        t += (t == "" ? "" : "+") + "M2"
    if useM3 and (_isLong ? m3Long : m3Short)
        t += (t == "" ? "" : "+") + "M3"
    t == "" ? "—" : t

// ─────────────────────────────────────────────────────────────────────────────
// 5) IMBALANCES (FVG) — cálculo interno; ocultos por defecto (gráfico limpio)
// ─────────────────────────────────────────────────────────────────────────────
grpV = "Imbalances (FVG)"
showFVG = input.bool(false, "Mostrar FVGs en el gráfico", group = grpV)
maxFVG  = input.int(20, "Máx. FVGs en memoria", minval = 1, maxval = 60, group = grpV)

var array<box> bullFVG = array.new<box>()
var array<box> bearFVG = array.new<box>()

colBull   = showFVG ? color.new(color.teal, 82) : color.new(color.teal, 100)
colBear   = showFVG ? color.new(color.red, 82) : color.new(color.red, 100)
colBorder = showFVG ? color.new(color.gray, 60) : color.new(color.gray, 100)

newBullFVG = low > high[2]
newBearFVG = high < low[2]
if newBullFVG
    array.push(bullFVG, box.new(bar_index - 2, low, bar_index, high[2], border_color = colBorder, bgcolor = colBull, extend = extend.right))
    if array.size(bullFVG) > maxFVG
        box.delete(array.shift(bullFVG))
if newBearFVG
    array.push(bearFVG, box.new(bar_index - 2, low[2], bar_index, high, border_color = colBorder, bgcolor = colBear, extend = extend.right))
    if array.size(bearFVG) > maxFVG
        box.delete(array.shift(bearFVG))

f_scanFVG(_arr, _isBull) =>
    tapped = false
    if array.size(_arr) > 0
        for i = array.size(_arr) - 1 to 0
            bx  = array.get(_arr, i)
            top = box.get_top(bx)
            bot = box.get_bottom(bx)
            filled = _isBull ? close < bot : close > top
            if filled
                box.delete(array.remove(_arr, i))
            else if _isBull ? (low <= top and close > bot) : (high >= bot and close < top)
                tapped := true
    tapped

tapFVGLong  = f_scanFVG(bullFVG, true)
tapFVGShort = f_scanFVG(bearFVG, false)

// ─────────────────────────────────────────────────────────────────────────────
// 6) MODELO DE ENTRADA — dos capas separadas
//
//    CAPA ALTA (4H/1H/15m): dónde. Define el rango, el fib y la dirección.
//    Marca una ZONA DE INTERÉS, nada más.
//    CAPA BAJA (5m/2m/1m):  si se entra o no. Ahí tiene que verse el modelo:
//    manipulación → imbalance → cambio de dirección que invalida los
//    imbalances contrarios.
//
//    Regla del mentor: una zona de interés NO es una entrada. Si la
//    temporalidad menor no confirma el movimiento, no hay operación.
// ─────────────────────────────────────────────────────────────────────────────
grpC = "Confirmación"
needConfirm = input.bool(true, "Exigir confirmación (zona ≠ entrada)", group = grpC, tooltip = "Si se desactiva, basta con la zona de interés. NO recomendado: es lo que produce entradas prematuras.")
useLTF      = input.bool(true, "Confirmar en temporalidad MENOR", group = grpC, tooltip = "El modelo de entrada se busca en una temporalidad menor a la del gráfico (ej. gráfico 15m, confirmación en 1m)")
ltfTF       = input.timeframe("1", "Temporalidad de confirmación", group = grpC, tooltip = "1 = 1m, 2 = 2m, 5 = 5m. Debe ser menor que la del gráfico; si no, se confirma en el propio gráfico")
useEngulf   = input.bool(true, "· Vela envolvente", group = grpC)
useChoch    = input.bool(true, "· Cambio de estructura (CHoCH)", group = grpC)
useFVGconf  = input.bool(true, "· Nuevo imbalance a favor", group = grpC)
useInval    = input.bool(true, "· Invalidación de imbalance contrario", group = grpC, tooltip = "El precio cierra atravesando un imbalance de la dirección opuesta: señal de que el otro lado perdió el control")
invLookback = input.int(15, "Velas para buscar imbalances contrarios", minval = 3, maxval = 40, group = grpC)
manipWindow = input.int(5, "Velas máx. entre manipulación y confirmación", minval = 1, maxval = 20, group = grpC)

// Manipulación: barrido de un swing interno, barrido de highs/lows iguales
// (EQH/EQL) o tap de un imbalance
sweepEqLow  = not na(eqLow) and low < eqLow and close > eqLow and (na(rangeLow) or low > rangeLow)
sweepEqHigh = not na(eqHigh) and high > eqHigh and close < eqHigh and (na(rangeHigh) or high < rangeHigh)
manipLong  = (not na(intLow) and low < intLow and close > intLow and (na(rangeLow) or low > rangeLow)) or sweepEqLow or tapFVGLong
manipShort = (not na(intHigh) and high > intHigh and close < intHigh and (na(rangeHigh) or high < rangeHigh)) or sweepEqHigh or tapFVGShort
manipRecentLong  = ta.barssince(manipLong) <= manipWindow
manipRecentShort = ta.barssince(manipShort) <= manipWindow

// --- Modelo de confirmación (se evalúa en la temporalidad menor o, si no
//     procede, en la del propio gráfico). Devuelve [confirmaLargo, confirmaCorto]
f_confirmModel() =>
    engBull = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
    engBear = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
    fvgBull = low > high[2] and close > open
    fvgBear = high < low[2] and close < open
    // CHoCH: rotura del último swing menor
    ph = ta.pivothigh(2, 2)
    pl = ta.pivotlow(2, 2)
    var float sh = na
    var float sl = na
    if not na(ph)
        sh := ph
    if not na(pl)
        sl := pl
    chBull = not na(sh) and close > sh and close[1] <= sh
    chBear = not na(sl) and close < sl and close[1] >= sl
    // Invalidación de imbalances contrarios: el precio cierra atravesando un
    // FVG del bando opuesto → ese lado perdió el control
    invalBull = false   // se invalidó un FVG alcista → presión bajista
    invalBear = false   // se invalidó un FVG bajista → presión alcista
    for i = 1 to invLookback
        if low[i] > high[i + 2] and close < high[i + 2]
            invalBull := true
        if high[i] < low[i + 2] and close > low[i + 2]
            invalBear := true
    cLong  = (useEngulf and engBull) or (useChoch and chBull) or (useFVGconf and fvgBull) or (useInval and invalBear)
    cShort = (useEngulf and engBear) or (useChoch and chBear) or (useFVGconf and fvgBear) or (useInval and invalBull)
    [cLong, cShort]

f_anyTrue(_arr) =>
    r = false
    if not na(_arr) and array.size(_arr) > 0
        for v in _arr
            if v
                r := true
    r

// Solo se puede confirmar en temporalidad menor si realmente es menor que la
// del gráfico; si no, el modelo se busca en el propio gráfico.
ltfValid = useLTF and timeframe.in_seconds(ltfTF) < timeframe.in_seconds(timeframe.period)

[cLongChart, cShortChart] = f_confirmModel()
[cLongArr, cShortArr] = request.security_lower_tf(syminfo.tickerid, ltfValid ? ltfTF : timeframe.period, f_confirmModel())

modelLong  = ltfValid ? f_anyTrue(cLongArr) : cLongChart
modelShort = ltfValid ? f_anyTrue(cShortArr) : cShortChart

confirmLong  = not needConfirm or modelLong
confirmShort = not needConfirm or modelShort

// ZONA DE INTERÉS (capa alta): el precio está donde nos interesa y a favor del
// sesgo. Es condición NECESARIA pero NO SUFICIENTE — sin el modelo confirmado
// en la temporalidad menor, no hay entrada.
zoneLong  = inFibLong and biasOKLong and legOKLong and fractalLong and allowLongs and (na(rangeHigh) or close < rangeHigh)
zoneShort = inFibShort and biasOKShort and legOKShort and fractalShort and allowShorts and (na(rangeLow) or close > rangeLow)
inZone    = zoneLong or zoneShort

longRaw  = manipRecentLong and confirmLong and inFibLong and (na(rangeHigh) or close < rangeHigh)
shortRaw = manipRecentShort and confirmShort and inFibShort and (na(rangeLow) or close > rangeLow)

longCandidate  = longRaw and biasOKLong and legOKLong and fractalLong and allowLongs and inSession and signalsToday < maxPerDay and barstate.isconfirmed
shortCandidate = shortRaw and biasOKShort and legOKShort and fractalShort and allowShorts and inSession and signalsToday < maxPerDay and barstate.isconfirmed

// ─────────────────────────────────────────────────────────────────────────────
// 7) GESTIÓN — entrada, SL y hasta 4 take profits
//    Modo "Liquidez externa + extensiones fib": TP1 = extremo del rango (0%),
//    TP2 = extensión -14.6%, TP3 = -27.2%, TP4 = -41.4% (configurables).
//    Modo "Ratio R fijo": múltiplos de R.
// ─────────────────────────────────────────────────────────────────────────────
grpG = "Gestión"
tpMode   = input.string("Liquidez externa + extensiones fib", "Take profit", options = ["Liquidez externa + extensiones fib", "Ratio R fijo"], group = grpG)
numTPs   = input.int(2, "Número de take profits", minval = 1, maxval = 4, group = grpG, tooltip = "TP1 = liquidez externa (0% del fib). TP2/TP3/TP4 = extensiones del rango")
ext1     = input.float(0.146, "Extensión TP2 (-14.6%)", minval = 0.01, step = 0.001, group = grpG)
ext2     = input.float(0.272, "Extensión TP3 (-27.2%)", minval = 0.01, step = 0.001, group = grpG)
ext3     = input.float(0.414, "Extensión TP4 (-41.4%)", minval = 0.01, step = 0.001, group = grpG)
rr1      = input.float(1.0, "TP1 (R, si modo fijo)", minval = 0.5, step = 0.5, group = grpG)
rr2      = input.float(2.0, "TP2 (R, si modo fijo)", minval = 0.5, step = 0.5, group = grpG)
rr3      = input.float(3.0, "TP3 (R, si modo fijo)", minval = 0.5, step = 0.5, group = grpG)
rr4      = input.float(4.0, "TP4 (R, si modo fijo)", minval = 0.5, step = 0.5, group = grpG)
minRR    = input.float(1.0, "RR mínimo hasta la liquidez externa", minval = 0.1, step = 0.1, group = grpG)
slMode   = input.string("Extremo de la manipulación", "Colocación del stop loss", options = ["Extremo de la vela de señal", "Extremo de la manipulación", "Retroceso máximo del fib"], group = grpG, tooltip = "Extremo de la manipulación = el high/low más extremo desde la manipulación hasta la señal (cubre toda la mecha del barrido). Retroceso máximo del fib = detrás del 88.6%")
slBuffer = input.float(0.5, "Margen extra del SL (puntos)", minval = 0.0, step = 0.1, group = grpG)
tpExtMode = tpMode == "Liquidez externa + extensiones fib"

// Extremos del tramo manipulación→señal (ventana de confirmación)
manipHigh = ta.highest(high, manipWindow + 1)
manipLow  = ta.lowest(low, manipWindow + 1)

f_slLong() =>
    base = slMode == "Extremo de la manipulación" ? manipLow : slMode == "Retroceso máximo del fib" and not na(rangeSize) ? fibBotLong : low
    base - slBuffer
f_slShort() =>
    base = slMode == "Extremo de la manipulación" ? manipHigh : slMode == "Retroceso máximo del fib" and not na(rangeSize) ? fibTopShort : high
    base + slBuffer

var float entryPx = na
var float slPx    = na
var int   dirNow  = 0      // 1 = long, -1 = short, 0 = sin setup
var string modelTag = ""   // qué modelo(s) respaldaron la señal

// --- REGISTRO DE OPERACIONES -------------------------------------------------
// Cada operación se mide en R (múltiplos del riesgo inicial). Con varios TPs la
// posición se reparte en partes iguales: cada TP alcanzado suma su fracción,
// y si después salta el SL, lo que quede abierto pierde -1R de su fracción.
var float riskPts   = 0.0     // distancia entrada→SL de la operación en curso
var float tradeR    = 0.0     // R acumulada de la operación en curso
var float qtyLeft   = 1.0     // fracción de posición aún abierta
var bool  usedM1    = false
var bool  usedM2    = false
var bool  usedM3    = false

var int   nTrades = 0
var int   nWins   = 0
var float sumWin  = 0.0       // suma de R de las ganadoras
var float sumLoss = 0.0       // suma de |R| de las perdedoras
var float netR    = 0.0
var float maxR    = 0.0       // pico de R acumulada (para el drawdown)
var float ddR     = 0.0       // peor caída desde el pico, en R

var array<int>   mTrades = array.from(0, 0, 0)
var array<int>   mWins   = array.from(0, 0, 0)
var array<float> mNetR   = array.from(0.0, 0.0, 0.0)

var array<string> logRows = array.new<string>()
var array<float> tps = array.new<float>()
var int   tpsHit  = 0

// Dibujo del setup ACTIVO: se guarda para poder borrarlo al resolverse la
// operación (solo quedan como rastro la flecha BUY/SELL y la marca ✔/✘).
var array<line>  actLines  = array.new<line>()
var array<label> actLabels = array.new<label>()

f_clearLevels() =>
    while array.size(actLines) > 0
        line.delete(array.pop(actLines))
    while array.size(actLabels) > 0
        label.delete(array.pop(actLabels))

f_drawLevels() =>
    array.push(actLines, line.new(bar_index, entryPx, bar_index + 1, entryPx, color = color.gray, width = 2))
    array.push(actLines, line.new(bar_index, slPx, bar_index + 1, slPx, color = color.red, width = 2))
    array.push(actLabels, label.new(bar_index + 1, entryPx, "Entrada " + str.tostring(entryPx, format.mintick), style = label.style_label_left, color = color.new(color.gray, 70), textcolor = chart.fg_color, size = size.small))
    array.push(actLabels, label.new(bar_index + 1, slPx, "SL " + str.tostring(slPx, format.mintick), style = label.style_label_left, color = color.new(color.red, 70), textcolor = chart.fg_color, size = size.small))
    if array.size(tps) > 0
        for i = 0 to array.size(tps) - 1
            tpv = array.get(tps, i)
            array.push(actLines, line.new(bar_index, tpv, bar_index + 1, tpv, color = color.green, width = 2))
            array.push(actLabels, label.new(bar_index + 1, tpv, "TP" + str.tostring(i + 1) + " " + str.tostring(tpv, format.mintick), style = label.style_label_left, color = color.new(color.green, 70), textcolor = chart.fg_color, size = size.small))

f_tpString() =>
    s = ""
    if array.size(tps) > 0
        for i = 0 to array.size(tps) - 1
            s += " | TP" + str.tostring(i + 1) + ": " + str.tostring(array.get(tps, i), format.mintick)
    s

bool newLong  = false
bool newShort = false

if longCandidate and dirNow == 0
    e = close
    s = f_slLong()
    risk = e - s
    rewCheck = tpExtMode ? rangeHigh - e : risk * rr1
    if risk > 0 and not na(rewCheck) and rewCheck > 0 and (not tpExtMode or rewCheck / risk >= minRR)
        array.clear(tps)
        if tpExtMode
            // TP1 = liquidez externa (0% del fib); TP2..TP4 = extensiones del rango
            array.push(tps, rangeHigh)
            if numTPs >= 2
                array.push(tps, rangeHigh + rangeSize * ext1)
            if numTPs >= 3
                array.push(tps, rangeHigh + rangeSize * ext2)
            if numTPs == 4
                array.push(tps, rangeHigh + rangeSize * ext3)
        else
            array.push(tps, e + risk * rr1)
            if numTPs >= 2
                array.push(tps, e + risk * rr2)
            if numTPs >= 3
                array.push(tps, e + risk * rr3)
            if numTPs == 4
                array.push(tps, e + risk * rr4)
        entryPx := e
        slPx    := s
        dirNow  := 1
        tpsHit  := 0
        modelTag := f_models(true)
        riskPts := risk
        tradeR  := 0.0
        qtyLeft := 1.0
        usedM1  := useM1 and m1Long
        usedM2  := useM2 and m2Long
        usedM3  := useM3 and m3Long
        signalsToday += 1
        newLong := true
        f_drawLevels()

if shortCandidate and dirNow == 0 and not newLong
    e = close
    s = f_slShort()
    risk = s - e
    rewCheck = tpExtMode ? e - rangeLow : risk * rr1
    if risk > 0 and not na(rewCheck) and rewCheck > 0 and (not tpExtMode or rewCheck / risk >= minRR)
        array.clear(tps)
        if tpExtMode
            // TP1 = liquidez externa (0% del fib); TP2..TP4 = extensiones del rango
            array.push(tps, rangeLow)
            if numTPs >= 2
                array.push(tps, rangeLow - rangeSize * ext1)
            if numTPs >= 3
                array.push(tps, rangeLow - rangeSize * ext2)
            if numTPs == 4
                array.push(tps, rangeLow - rangeSize * ext3)
        else
            array.push(tps, e - risk * rr1)
            if numTPs >= 2
                array.push(tps, e - risk * rr2)
            if numTPs >= 3
                array.push(tps, e - risk * rr3)
            if numTPs == 4
                array.push(tps, e - risk * rr4)
        entryPx := e
        slPx    := s
        dirNow  := -1
        tpsHit  := 0
        modelTag := f_models(false)
        riskPts := risk
        tradeR  := 0.0
        qtyLeft := 1.0
        usedM1  := useM1 and m1Short
        usedM2  := useM2 and m2Short
        usedM3  := useM3 and m3Short
        signalsToday += 1
        newShort := true
        f_drawLevels()

// Mientras la operación siga viva, las líneas y etiquetas acompañan al precio
if dirNow != 0
    if array.size(actLines) > 0
        for ln in actLines
            line.set_x2(ln, bar_index + 1)
    if array.size(actLabels) > 0
        for lb in actLabels
            label.set_x(lb, bar_index + 1)

// Resolución: SL cierra el setup; los TPs se van marcando en orden.
// Al completarse la operación se borra su dibujo — solo quedan como rastro
// la flecha BUY/SELL de la entrada y las marcas ✔ TP / ✘ SL.
bool  tradeClosed = false
float closedR     = 0.0
int   closedDir   = 0
string closedWhy  = ""

if dirNow != 0 and not newLong and not newShort
    hitSL = dirNow == 1 ? low <= slPx : high >= slPx
    if hitSL
        label.new(bar_index, slPx, "✘ SL", style = dirNow == 1 ? label.style_label_up : label.style_label_down, color = color.red, textcolor = color.white, size = size.small)
        alert("✘ SL tocado " + syminfo.ticker, alert.freq_once_per_bar_close)
        tradeR := tradeR - qtyLeft          // lo que queda abierto pierde 1R de su fracción
        qtyLeft := 0.0
        tradeClosed := true
        closedR   := tradeR
        closedDir := dirNow
        closedWhy := tpsHit > 0 ? "SL tras TP" + str.tostring(tpsHit) : "SL"
        dirNow := 0
        f_clearLevels()
    else
        while tpsHit < array.size(tps) and (dirNow == 1 ? high >= array.get(tps, tpsHit) : low <= array.get(tps, tpsHit))
            tpsHit += 1
            tpv = array.get(tps, tpsHit - 1)
            frac = 1.0 / array.size(tps)
            rMult = riskPts > 0 ? (dirNow == 1 ? tpv - entryPx : entryPx - tpv) / riskPts : 0.0
            tradeR := tradeR + frac * rMult
            qtyLeft := math.max(0.0, qtyLeft - frac)
            label.new(bar_index, tpv, "✔ TP" + str.tostring(tpsHit), style = dirNow == 1 ? label.style_label_down : label.style_label_up, color = color.green, textcolor = color.white, size = size.small)
            alert("✔ TP" + str.tostring(tpsHit) + " alcanzado " + syminfo.ticker, alert.freq_once_per_bar_close)
        if tpsHit >= array.size(tps)
            tradeClosed := true
            closedR   := tradeR
            closedDir := dirNow
            closedWhy := "TP" + str.tostring(tpsHit) + " completo"
            dirNow := 0
            f_clearLevels()

// --- Actualización del registro al cerrarse una operación --------------------
if tradeClosed
    nTrades += 1
    netR += closedR
    if closedR > 0
        nWins += 1
        sumWin += closedR
    else
        sumLoss += math.abs(closedR)
    maxR := math.max(maxR, netR)
    ddR  := math.max(ddR, maxR - netR)
    if usedM1
        array.set(mTrades, 0, array.get(mTrades, 0) + 1)
        array.set(mNetR,   0, array.get(mNetR, 0) + closedR)
        if closedR > 0
            array.set(mWins, 0, array.get(mWins, 0) + 1)
    if usedM2
        array.set(mTrades, 1, array.get(mTrades, 1) + 1)
        array.set(mNetR,   1, array.get(mNetR, 1) + closedR)
        if closedR > 0
            array.set(mWins, 1, array.get(mWins, 1) + 1)
    if usedM3
        array.set(mTrades, 2, array.get(mTrades, 2) + 1)
        array.set(mNetR,   2, array.get(mNetR, 2) + closedR)
        if closedR > 0
            array.set(mWins, 2, array.get(mWins, 2) + 1)
    array.push(logRows, str.format_time(time, "dd/MM HH:mm", tzNY) + "  " + (closedDir == 1 ? "▲" : "▼") + "  " + modelTag + "  " + closedWhy + "  " + (closedR >= 0 ? "+" : "") + str.tostring(closedR, "#.##") + "R")
    if array.size(logRows) > 12
        array.shift(logRows)
    // Alerta con el resultado, para llevar el registro también fuera de TradingView
    alert("📊 CIERRE " + (closedDir == 1 ? "COMPRA" : "VENTA") + " [" + modelTag + "] " + syminfo.ticker + " | " + closedWhy + " | R: " + str.tostring(closedR, "#.##"), alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────────────────────
// 8) DIBUJO Y ALERTAS — solo lo esencial
// ─────────────────────────────────────────────────────────────────────────────
plotshape(newLong,  "Compra", shape.triangleup,   location.belowbar, color.green, size = size.small, text = "BUY")
plotshape(newShort, "Venta",  shape.triangledown, location.abovebar, color.red,   size = size.small, text = "SELL")

// Calibración: 100% y 0% del tramo detectado, para compararlos con el fib manual
plot(showRange ? (legBear ? rangeHigh : rangeLow) : na, "Tramo 100%", color = color.new(color.orange, 20), style = plot.style_linebr, linewidth = 1)
plot(showRange ? (legBear ? rangeLow : rangeHigh) : na, "Tramo 0%",   color = color.new(color.blue, 20),   style = plot.style_linebr, linewidth = 1)
bgcolor(shadeSessions and useSessions and inNY ? color.new(color.blue, 96) : shadeSessions and useSessions and inAsia ? color.new(color.purple, 96) : na, title = "Sesiones")

// Panel de estado: sesgo (capa alta) y si estamos en zona de interés esperando
// que la temporalidad menor confirme el modelo (capa baja)
// Cadena fractal: diario → estructural → ejecución → confirmación
var table tb = table.new(position.top_right, 1, 4, border_width = 1)
if barstate.islast
    // Fila 1 — liquidez diaria manipulada
    mLongTxt  = f_models(true)
    mShortTxt = f_models(false)
    modTxt = "Modelos ▲ " + mLongTxt + "   ▼ " + mShortTxt + (pdHighSwept ? "   · alto día barrido" : pdLowSwept ? "   · bajo día barrido" : "")
    modCol = mLongTxt != "—" or mShortTxt != "—" ? color.new(color.purple, 35) : color.new(color.gray, 60)
    table.cell(tb, 0, 0, modTxt, bgcolor = modCol, text_color = color.white, text_size = size.small)
    // Fila 2 — estructura mayor
    structTxt = na(structHigh) ? structTF + ": sin tramo" : structTF + ": " + (structBear ? "▼" : "▲") + " " + str.tostring(structBear ? structHigh : structLow, format.mintick) + "→" + str.tostring(structBear ? structLow : structHigh, format.mintick) + (inStructFibShort or inStructFibLong ? "  ✓ en zona" : "")
    structCol = structBear ? color.new(color.red, 35) : color.new(color.green, 35)
    table.cell(tb, 0, 1, structTxt, bgcolor = structCol, text_color = color.white, text_size = size.small)
    // Fila 3 — tramo de ejecución
    legTxt = na(rangeHigh) ? rangeTF + ": sin tramo" : rangeTF + ": " + (legBear ? "▼" : "▲") + " " + str.tostring(legBear ? rangeHigh : rangeLow, format.mintick) + "→" + str.tostring(legBear ? rangeLow : rangeHigh, format.mintick)
    legCol = legBear ? color.new(color.red, 45) : color.new(color.green, 45)
    table.cell(tb, 0, 2, legTxt, bgcolor = legCol, text_color = color.white, text_size = size.small)
    // Fila 4 — estado operativo
    zoneTxt = dirNow != 0 ? "OPERACIÓN ACTIVA" : inZone ? "EN ZONA — esperando confirmación " + (ltfValid ? ltfTF : timeframe.period) : "Fuera de zona"
    zoneCol = dirNow != 0 ? color.new(color.blue, 30) : inZone ? color.new(color.orange, 30) : color.new(color.gray, 55)
    table.cell(tb, 0, 3, zoneTxt, bgcolor = zoneCol, text_color = color.white, text_size = size.small)

if newLong
    alert("🟢 COMPRA [" + modelTag + "] " + syminfo.ticker + " | Entrada: " + str.tostring(entryPx, format.mintick) + " | SL: " + str.tostring(slPx, format.mintick) + f_tpString(), alert.freq_once_per_bar_close)
if newShort
    alert("🔴 VENTA [" + modelTag + "] " + syminfo.ticker + " | Entrada: " + str.tostring(entryPx, format.mintick) + " | SL: " + str.tostring(slPx, format.mintick) + f_tpString(), alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────────────────────
// 9) REGISTRO — estadísticas y bitácora de operaciones
//
//    Todo se mide en R (múltiplos del riesgo). Las cifras corresponden a las
//    señales visibles en el histórico del gráfico: si cambias de temporalidad
//    o de rango de fechas, se recalculan.
// ─────────────────────────────────────────────────────────────────────────────
posStats = statsPos == "Abajo izquierda" ? position.bottom_left : statsPos == "Arriba izquierda" ? position.top_left : position.bottom_right

var table st = table.new(posStats, 5, 7, border_width = 1)
if barstate.islast and showStats
    table.clear(st, 0, 0, 4, 6)
    cHead = color.new(color.gray, 20)
    cBody = color.new(color.black, 55)
    winRate = nTrades > 0 ? 100.0 * nWins / nTrades : 0.0
    pf      = sumLoss > 0 ? sumWin / sumLoss : (sumWin > 0 ? 999.0 : 0.0)
    avgR    = nTrades > 0 ? netR / nTrades : 0.0
    pfTxt   = sumLoss > 0 ? str.tostring(pf, "#.##") : (sumWin > 0 ? "∞" : "—")
    // Cabecera
    table.cell(st, 0, 0, "RENDIMIENTO", bgcolor = cHead, text_color = color.white, text_size = size.small)
    table.cell(st, 1, 0, "Ops",      bgcolor = cHead, text_color = color.white, text_size = size.small)
    table.cell(st, 2, 0, "Aciertos", bgcolor = cHead, text_color = color.white, text_size = size.small)
    table.cell(st, 3, 0, "R neta",   bgcolor = cHead, text_color = color.white, text_size = size.small)
    table.cell(st, 4, 0, "R media",  bgcolor = cHead, text_color = color.white, text_size = size.small)
    // Global
    netCol = netR > 0 ? color.new(color.green, 45) : netR < 0 ? color.new(color.red, 45) : cBody
    table.cell(st, 0, 1, "TOTAL", bgcolor = netCol, text_color = color.white, text_size = size.small)
    table.cell(st, 1, 1, str.tostring(nTrades), bgcolor = netCol, text_color = color.white, text_size = size.small)
    table.cell(st, 2, 1, str.tostring(winRate, "#.#") + "%", bgcolor = netCol, text_color = color.white, text_size = size.small)
    table.cell(st, 3, 1, (netR >= 0 ? "+" : "") + str.tostring(netR, "#.##"), bgcolor = netCol, text_color = color.white, text_size = size.small)
    table.cell(st, 4, 1, (avgR >= 0 ? "+" : "") + str.tostring(avgR, "#.##"), bgcolor = netCol, text_color = color.white, text_size = size.small)
    // Profit factor y drawdown
    table.cell(st, 0, 2, "Profit factor", bgcolor = cBody, text_color = color.white, text_size = size.small)
    table.cell(st, 1, 2, pfTxt, bgcolor = pf >= 1.5 ? color.new(color.green, 45) : pf >= 1.0 ? color.new(color.orange, 45) : color.new(color.red, 45), text_color = color.white, text_size = size.small)
    table.cell(st, 2, 2, "Racha adversa", bgcolor = cBody, text_color = color.white, text_size = size.small)
    table.cell(st, 3, 2, "-" + str.tostring(ddR, "#.##") + "R", bgcolor = cBody, text_color = color.white, text_size = size.small)
    table.cell(st, 4, 2, "", bgcolor = cBody)
    // Desglose por modelo
    table.cell(st, 0, 3, "POR MODELO", bgcolor = cHead, text_color = color.white, text_size = size.small)
    table.cell(st, 1, 3, "Ops",      bgcolor = cHead, text_color = color.white, text_size = size.small)
    table.cell(st, 2, 3, "Aciertos", bgcolor = cHead, text_color = color.white, text_size = size.small)
    table.cell(st, 3, 3, "R neta",   bgcolor = cHead, text_color = color.white, text_size = size.small)
    table.cell(st, 4, 3, "R media",  bgcolor = cHead, text_color = color.white, text_size = size.small)
    for i = 0 to 2
        mt = array.get(mTrades, i)
        mw = array.get(mWins, i)
        mr = array.get(mNetR, i)
        active = i == 0 ? useM1 : i == 1 ? useM2 : useM3
        nameTxt = (i == 0 ? "M1 estructura" : i == 1 ? "M2 manip. diaria" : "M3 imbalance") + (active ? "" : " (off)")
        rowCol = mt == 0 ? color.new(color.gray, 70) : mr > 0 ? color.new(color.green, 55) : color.new(color.red, 55)
        table.cell(st, 0, 4 + i, nameTxt, bgcolor = rowCol, text_color = color.white, text_size = size.tiny)
        table.cell(st, 1, 4 + i, str.tostring(mt), bgcolor = rowCol, text_color = color.white, text_size = size.tiny)
        table.cell(st, 2, 4 + i, mt > 0 ? str.tostring(100.0 * mw / mt, "#.#") + "%" : "—", bgcolor = rowCol, text_color = color.white, text_size = size.tiny)
        table.cell(st, 3, 4 + i, mt > 0 ? (mr >= 0 ? "+" : "") + str.tostring(mr, "#.##") : "—", bgcolor = rowCol, text_color = color.white, text_size = size.tiny)
        table.cell(st, 4, 4 + i, mt > 0 ? (mr / mt >= 0 ? "+" : "") + str.tostring(mr / mt, "#.##") : "—", bgcolor = rowCol, text_color = color.white, text_size = size.tiny)

// Bitácora: últimas operaciones con su razón
var table lg = table.new(position.bottom_left, 1, 13, border_width = 1)
if barstate.islast and showLog
    table.clear(lg, 0, 0, 0, 12)
    table.cell(lg, 0, 0, "ÚLTIMAS OPERACIONES  (fecha · dir · modelo · cierre · R)", bgcolor = color.new(color.gray, 20), text_color = color.white, text_size = size.tiny)
    n = array.size(logRows)
    if n > 0
        for i = 0 to n - 1
            txt = array.get(logRows, n - 1 - i)
            neg = str.contains(txt, "-") and not str.contains(txt, "+")
            table.cell(lg, 0, i + 1, txt, bgcolor = neg ? color.new(color.red, 65) : color.new(color.green, 65), text_color = color.white, text_size = size.tiny)
